#: package/contents/config/config.qml:6
msgctxt "@title configuration page"
msgid "General"
msgstr "Geral"

#: package/contents/ui/configGeneral.qml:18
msgctxt "@label:textbox"
msgid "Binary path:"
msgstr "Caminho do binário:"

#: package/contents/ui/configGeneral.qml:19
msgctxt "@info:placeholder"
msgid "ai-usagebar (looked up in PATH)"
msgstr "ai-usagebar (procurado no PATH)"

#: package/contents/ui/configGeneral.qml:25
msgctxt "@label:spinbox"
msgid "Interval (seconds):"
msgstr "Intervalo (segundos):"

#: package/contents/ui/configGeneral.qml:33
msgctxt "@label:listbox"
msgid "Provider:"
msgstr "Provedor:"

#: package/contents/ui/configGeneral.qml:38
msgctxt "@item:inlistbox no provider pinned"
msgid "(cycled / config.toml)"
msgstr "(alternado / config.toml)"

#: package/contents/ui/configGeneral.qml:64
msgctxt "@label:textbox"
msgid "Extra arguments:"
msgstr "Argumentos extras:"

#: package/contents/ui/configGeneral.qml:75
msgctxt "@label:checkbox"
msgid "Mouse wheel:"
msgstr "Roda do mouse:"

#: package/contents/ui/configGeneral.qml:76
msgctxt "@option:check"
msgid "switches provider"
msgstr "alterna entre os provedores"

#: package/contents/ui/configGeneral.qml:81
msgctxt "@label:checkbox providers without an API key"
msgid "Without credentials:"
msgstr "Sem credenciais:"

#: package/contents/ui/configGeneral.qml:82
msgctxt "@option:check"
msgid "hide in the popup and skip when switching"
msgstr "ocultar no popup e pular ao alternar"

#: package/contents/ui/configGeneral.qml:91
msgctxt "@info:usagetip"
msgid "Switching to a provider without a key would only show a warning in the panel; with this option the wheel and the buttons pass over it."
msgstr "Alternar para um provedor sem chave só mostraria um aviso no painel; com esta opção a roda e os botões passam direto por ele."

#: package/contents/ui/main.qml:113
msgctxt "@info:status %1 is the process exit code"
msgid "No output (exit code %1). Is the ai-usagebar binary installed?"
msgstr "Nenhuma saída (código de saída %1). O binário ai-usagebar está instalado?"

#: package/contents/ui/main.qml:125
msgctxt "@info:status %1 is the raw command output"
msgid "Unexpected answer: %1"
msgstr "Resposta inesperada: %1"

#: package/contents/ui/main.qml:143
msgctxt "@info:status %1 is the process exit code"
msgid "`ai-usagebar usage --json` produced no output (exit code %1)."
msgstr "`ai-usagebar usage --json` não produziu saída (código de saída %1)."

#: package/contents/ui/main.qml:159
msgctxt "@info:status"
msgid "The usage command returned invalid JSON."
msgstr "O comando de uso devolveu um JSON inválido."

#: package/contents/ui/main.qml:161
msgctxt "@info:status"
msgid "The usage command returned an unsupported report."
msgstr "O comando de uso devolveu um relatório não suportado."

#: package/contents/ui/main.qml:163
msgctxt "@info:status"
msgid "The usage report contained no valid provider entry."
msgstr "O relatório de uso não trouxe nenhum provedor válido."

#: package/contents/ui/main.qml:351 package/contents/ui/main.qml:495
msgctxt "@info:status"
msgid "Loading…"
msgstr "carregando…"

#: package/contents/ui/main.qml:389
msgctxt "@title popup header"
msgid "AI usage"
msgstr "Uso das IAs"

#: package/contents/ui/main.qml:395
msgctxt "@action:button"
msgid "Previous provider"
msgstr "Provedor anterior"

#: package/contents/ui/main.qml:405
msgctxt "@action:button"
msgid "Next provider"
msgstr "Próximo provedor"

#: package/contents/ui/main.qml:415
msgctxt "@action:button"
msgid "Refresh"
msgstr "Atualizar"

#: package/contents/ui/main.qml:474
msgctxt "@info:status %1 is a number of providers"
msgid "%1 provider without credentials is hidden"
msgid_plural "%1 providers without credentials are hidden"
msgstr[0] "%1 provedor sem credenciais foi ocultado"
msgstr[1] "%1 provedores sem credenciais foram ocultados"

#: package/contents/ui/main.qml:484
msgctxt "@info:placeholder"
msgid "Could not read the usage report"
msgstr "Não foi possível ler o relatório de uso"

#: package/contents/ui/main.qml:509
msgctxt "@action"
msgid "Refresh now"
msgstr "Atualizar agora"

#: package/contents/ui/main.qml:517
msgctxt "@action"
msgid "Next provider"
msgstr "Próximo provedor"

#: package/contents/ui/main.qml:522
msgctxt "@action"
msgid "Previous provider"
msgstr "Provedor anterior"

#: package/contents/ui/MetricSection.qml:28
msgctxt "@label time until the quota window resets"
msgid "Resets in %1"
msgstr "Reseta em %1"

#: package/contents/ui/MetricSection.qml:29
msgctxt "@label the quota window is past its reset time"
msgid "Reset due"
msgstr "Reset vencido"

#: package/contents/ui/MetricSection.qml:36
msgctxt "@label share of the quota window that has passed"
msgid "%1% elapsed"
msgstr "%1% decorrido"

#: package/contents/ui/MetricSection.qml:39
msgctxt "@label usage matches the elapsed time"
msgid "on pace"
msgstr "no ritmo"

#: package/contents/ui/MetricSection.qml:43
msgctxt "@label using quota faster than the clock, in percentage points"
msgid "%1 pts ahead"
msgstr "%1 pts acima do ritmo"

#: package/contents/ui/MetricSection.qml:45
msgctxt "@label using quota slower than the clock, in percentage points"
msgid "%1 pts under"
msgstr "%1 pts abaixo do ritmo"

#: package/contents/ui/VendorCard.qml:34
msgctxt "@info the reading was taken seconds ago"
msgid "Updated just now"
msgstr "atualizado agora"

#: package/contents/ui/VendorCard.qml:35
msgctxt "@info how long ago the reading was taken"
msgid "Updated %1 ago"
msgstr "atualizado há %1"

#: package/contents/ui/VendorCard.qml:119
msgctxt "@info the provider answered from a stale cache"
msgid "cached"
msgstr "cache antigo"

#: package/contents/ui/VendorCard.qml:143
msgctxt "@info provider without an API key or login"
msgid "No credentials configured"
msgstr "Sem credenciais configuradas"
