pkgbase = ai-usagebar
	pkgdesc = Waybar widget + TUI for tracking AI plan usage across multiple providers
	pkgver = 0.21.0
	pkgrel = 1
	url = https://github.com/akitaonrails/ai-usagebar
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = git
	makedepends = nasm
	depends = gcc-libs
	optdepends = waybar: status bar that hosts the widget
	optdepends = plasma-desktop: KDE Plasma 6 panel that hosts the plasmoid
	optdepends = plasma5support: QML executable data engine the plasmoid runs the binary through
	optdepends = libnotify: desktop notifications on hard auth failures
	conflicts = ai-usagebar-bin
	options = !lto
	options = !debug
	source = ai-usagebar-0.21.0.tar.gz::https://github.com/akitaonrails/ai-usagebar/archive/refs/tags/v0.21.0.tar.gz
	sha256sums = SKIP

pkgname = ai-usagebar
