<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">

  <!-- Empty name is correct for a plasmoid: it routes storage into this
       applet instance's own section of plasma-org.kde.plasma.desktop-appletsrc,
       which is what makes two panel instances independent. -->
  <kcfgfile name=""/>

  <group name="General">
    <!-- The vendor shown right now. The aggregate command omits a vendor and
         this applet selects an entry client-side, so it never reads
         ~/.cache/ai-usagebar/active_vendor. Scrolling one instance cannot move
         another instance or a running Waybar.
         NB: an XML comment may not contain a double hyphen, so option names
         are written without their leading dashes throughout this file. -->
    <entry name="vendor" type="String">
      <default>anthropic</default>
    </entry>

    <!-- Ring the mouse wheel cycles through. Deliberately just one vendor by
         default: cycling into a vendor you have no subscription for only ever
         shows a credentials error, so the config page lets you tick the ones you
         actually have (with their live status) instead of guessing here. -->
    <entry name="vendorRing" type="StringList">
      <default>anthropic</default>
    </entry>

    <!-- One report covers every configured provider. The binary cache handles
         shorter provider TTLs between these aggregate refreshes. -->
    <entry name="interval" type="Int">
      <default>300</default>
      <min>30</min>
      <max>3600</max>
    </entry>

    <!-- Aggregate reports may contact several providers sequentially. Keep the
         process bound configurable, but never short enough to disable the
         wrapper or kill a normal multi-provider run. -->
    <entry name="commandTimeout" type="Int">
      <default>600</default>
      <min>60</min>
      <max>3600</max>
    </entry>

    <!-- plasmashell's PATH is the session's, not your interactive shell's, so
         ~/.cargo/bin is typically absent. Empty means "search PATH". -->
    <entry name="binaryPath" type="String">
      <default></default>
    </entry>

    <!-- Read back as the integer index, not the choice name. -->
    <entry name="leftClickAction" type="Enum">
      <choices>
        <choice name="ExpandPopup"/>
        <choice name="LaunchTui"/>
      </choices>
      <default>ExpandPopup</default>
    </entry>

    <!-- Popup layout. ProviderTabs is the report shaped view with one selected
         entry; VendorCards lays every entry the report returned out as a card
         with one gauge row per window. Both are projections of the same single
         aggregate usage report, so switching never refetches. -->
    <entry name="viewMode" type="Enum">
      <choices>
        <choice name="ProviderTabs"/>
        <choice name="VendorCards"/>
      </choices>
      <default>ProviderTabs</default>
    </entry>

    <entry name="terminalCommand" type="String">
      <default></default>
    </entry>

    <entry name="useThemeColors" type="Bool">
      <default>true</default>
    </entry>

    <!-- Used when useThemeColors is off. Same five keys, same One Dark
         defaults, and the same severity bands as the GNOME extension and the
         macOS app, so turning the theme off reproduces their look exactly. -->
    <entry name="colorLow" type="String">
      <default>#98c379</default>
    </entry>

    <entry name="colorMid" type="String">
      <default>#e5c07b</default>
    </entry>

    <entry name="colorHigh" type="String">
      <default>#d19a66</default>
    </entry>

    <entry name="colorCritical" type="String">
      <default>#e06c75</default>
    </entry>

    <entry name="colorEmpty" type="String">
      <default>#3e4451</default>
    </entry>

    <entry name="showBars" type="Bool">
      <default>true</default>
    </entry>

    <entry name="showPercent" type="Bool">
      <default>true</default>
    </entry>

    <entry name="barWidth" type="Int">
      <default>8</default>
      <min>4</min>
      <max>20</max>
    </entry>
  </group>
</kcfg>
