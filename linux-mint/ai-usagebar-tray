def provider_icon(entry, title, dark=False):
    """Reuse the provider marks already shipped by the Omarchy frontend."""
    brand = str(entry.get("brand") or entry.get("id") or "").split("@", 1)[0]
    filename = ICON_FILES.get(brand)
    if filename:
        for icon_dir in (SOURCE_ICON_DIR, INSTALLED_ICON_DIR):
            path = os.path.join(icon_dir, filename)
            if not os.path.isfile(path):
                continue
            try:
                with open(path, "rb") as icon_file:
                    tint = b"#aab3c0" if dark else b"#717982"
                    svg = icon_file.read().replace(b"#ffffff", tint).replace(b"currentColor", tint)
                loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
                loader.set_size(20, 20)
                loader.write(svg)
                loader.close()
                image = Gtk.Image.new_from_pixbuf(loader.get_pixbuf())
                image.set_size_request(22, 22)
                return image
            except (OSError, GLib.Error):
                continue
    initials = (title.strip()[:2] or "?").upper()
    fallback = Gtk.Label(label=initials)
    fallback.get_style_context().add_class("provider-initials")
    fallback.set_size_request(22, 22)
    return fallback

def get_theme_mode():
    """Detect if Linux Mint is in Dark or Light mode."""
    try:
        settings = Gtk.Settings.get_default()
        theme_name = os.environ.get("GTK_THEME") or settings.get_property("gtk-theme-name") or ""
        prefer_dark = settings.get_property("gtk-application-prefer-dark-theme")
        if prefer_dark or "-Dark" in theme_name or "-dark" in theme_name:
            return "dark"
    except Exception:
        pass
    return "light"

